// Exe icon and version details. build.bat passes LW_VERNUM (1,2,3,0) and LW_VERSTR ("1.2.3").
#include <winres.h>

#ifndef LW_VERNUM
#define LW_VERNUM 0,0,0,0
#endif
#ifndef LW_VERSTR
#define LW_VERSTR "dev"
#endif

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LW_VERNUM
PRODUCTVERSION LW_VERNUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LiteWallpaper"
            VALUE "FileDescription", "LiteWallpaper animated wallpaper"
            VALUE "FileVersion", LW_VERSTR
            VALUE "InternalName", "LiteWallpaper"
            VALUE "OriginalFilename", "LiteWallpaper.exe"
            VALUE "ProductName", "LiteWallpaper"
            VALUE "ProductVersion", LW_VERSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
